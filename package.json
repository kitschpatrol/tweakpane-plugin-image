{
	"name": "@kitschpatrol/tweakpane-plugin-image",
	"version": "2.0.1-fork.1",
	"description": "Fork of tweakpane-image-plugin with build optimizations.",
	"keywords": [
		"npm-package",
		"tweakpane",
		"tweakpane-plugin"
	],
	"homepage": "https://github.com/kitschpatrol/tweakpane-plugin-image",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kitschpatrol/tweakpane-plugin-image.git"
	},
	"license": "MIT",
	"author": "Florian Morel, Matheus Dias <methidezeeni@gmail.com>",
	"maintainers": [
		{
			"name": "Eric Mika",
			"email": "eric@ericmika.com",
			"url": "https://ericmika.com"
		}
	],
	"sideEffects": false,
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/tweakpane-plugin-image.d.ts",
			"default": "./dist/tweakpane-plugin-image.js"
		},
		"./lite": {
			"types": "./dist/tweakpane-plugin-image.d.ts",
			"default": "./dist/tweakpane-plugin-image.lite.js"
		},
		"./package.json": "./package.json"
	},
	"main": "./dist/tweakpane-plugin-image.js",
	"module": "./dist/tweakpane-plugin-image.js",
	"types": "./dist/tweakpane-plugin-image.d.ts",
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsdown",
		"clean-deep": "shx rm -f pnpm-lock.yaml && git clean -fdX",
		"dev": "vite",
		"fix": "ksc fix",
		"lint": "ksc lint",
		"release": "bumpp --preid fork --commit 'Release: %s' --tag '%s' --all --execute 'chagent' && pnpm build && pnpm publish --otp $(op item get npm --otp) --tag latest",
		"test": "vitest run",
		"watch": "tsdown --watch"
	},
	"dependencies": {
		"@tweakpane/core": "^2.0.5"
	},
	"devDependencies": {
		"@arethetypeswrong/core": "^0.18.5",
		"@kitschpatrol/chagent": "^0.5.0",
		"@kitschpatrol/shared-config": "^8.14.1",
		"@tsdown/css": "0.23.4",
		"@types/node": "~24.13.6",
		"bumpp": "^12.3.0",
		"happy-dom": "^21.0.4",
		"publint": "^0.3.25",
		"sass": "^1.107.1",
		"shx": "^0.4.0",
		"stylelint-config-standard-scss": "^17.0.0",
		"tsdown": "0.23.4",
		"tweakpane": "^4.0.5",
		"typescript": "~6.0.3",
		"vite": "^8.3.5",
		"vitest": "^5.0.5"
	},
	"peerDependencies": {
		"tweakpane": "^4.0.0"
	},
	"packageManager": "pnpm@12.16.1",
	"engines": {
		"node": ">=18.0.0"
	},
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": "^24.16.0 || >=26.3.0"
		}
	},
	"publishConfig": {
		"access": "public"
	}
}
