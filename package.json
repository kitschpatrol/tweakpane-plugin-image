{
	"name": "@kitschpatrol/tweakpane-plugin-image",
	"version": "2.0.1-fork.1",
	"type": "module",
	"description": "Fork of tweakpane-image-plugin with build optimizations.",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kitschpatrol/tweakpane-plugin-image.git"
	},
	"homepage": "https://github.com/kitschpatrol/tweakpane-plugin-image",
	"author": "Florian Morel, Matheus Dias <methidezeeni@gmail.com>",
	"maintainers": [
		{
			"name": "Eric Mika",
			"email": "eric@ericmika.com",
			"url": "https://ericmika.com"
		}
	],
	"license": "MIT",
	"packageManager": "pnpm@12.15.0",
	"engines": {
		"node": ">=18.0.0"
	},
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": "^24.16.0 || >=26.3.0"
		}
	},
	"main": "dist/tweakpane-plugin-image.js",
	"types": "dist/types/index.d.ts",
	"files": [
		"dist"
	],
	"keywords": [
		"npm-package",
		"tweakpane",
		"tweakpane-plugin"
	],
	"scripts": {
		"assets": "pnpm run clean && pnpm run build && pnpm run assets:version && pnpm run assets:zip",
		"assets:version": "node scripts/assets-append-version.js",
		"assets:zip": "zip -x '*types*' -j -r $(node scripts/dist-name.js)-$(node -p \"require('./package.json').version\").zip dist",
		"build": "pnpm run '/^build:/'",
		"build:dev": "rollup --config rollup.config.js",
		"build:dts": "tsc --project src/tsconfig-dts.json",
		"build:prod": "rollup --config rollup.config.js --environment BUILD:production",
		"clean": "shx rm -rf dist *.tgz *.zip",
		"clean-deep": "shx rm -f pnpm-lock.yaml && git clean -fdX",
		"format": "pnpm run '/^format:/'",
		"format:readme": "mdat expand",
		"format:scss": "prettier --parser scss --write \"src/sass/**/*.scss\"",
		"format:ts": "eslint --ext .ts --fix \"src/**/*.ts\"",
		"prepare": "pnpm run clean && pnpm run build",
		"release": "pnpm test && pnpm build && bumpp --preid fork --commit 'Release: %s' --tag '%s' && NPM_TOKEN=$(op read 'op://Personal/npm/token') pnpm publish --tag latest",
		"server": "http-server -c-1 -o /test/browser.html",
		"start": "pnpm run '/^(watch|server)$/'",
		"test": "eslint --ext .ts \"src/**/*.ts\" && mdat check",
		"watch": "rollup --config rollup.config.js --watch --no-watch.clearScreen"
	},
	"peerDependencies": {
		"tweakpane": "^4.0.0"
	},
	"dependencies": {
		"@tweakpane/core": "^2.0.5"
	},
	"devDependencies": {
		"@eslint/eslintrc": "^3.3.7",
		"@eslint/js": "^10.0.1",
		"@rollup/plugin-node-resolve": "^16.0.3",
		"@rollup/plugin-replace": "^6.0.3",
		"@rollup/plugin-terser": "^1.0.0",
		"@rollup/plugin-typescript": "^12.3.0",
		"@typescript-eslint/eslint-plugin": "^8.71.2",
		"@typescript-eslint/parser": "^8.71.2",
		"autoprefixer": "^10.6.1",
		"bumpp": "^12.3.0",
		"eslint": "^10.12.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-prettier": "^5.5.7",
		"eslint-plugin-simple-import-sort": "^14.0.0",
		"glob": "^13.0.6",
		"http-server": "^14.1.1",
		"mdat": "^3.6.2",
		"postcss": "^8.5.30",
		"prettier": "^3.9.10",
		"prettier-plugin-pkg": "^0.22.1",
		"rollup": "^4.64.6",
		"rollup-plugin-cleanup": "^3.2.1",
		"sass": "^1.105.1",
		"shx": "^0.4.0",
		"tslib": "^2.8.1",
		"tweakpane": "^4.0.5",
		"typescript": "~6.0.3"
	},
	"publishConfig": {
		"access": "public"
	}
}
